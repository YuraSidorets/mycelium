FROM mcr.microsoft.com/powershell:7.5-ubuntu-24.04

USER root

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends ca-certificates git python3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 20000 evaluator \
    && useradd --uid 20000 --gid 20000 --create-home --shell /bin/bash evaluator

RUN mkdir -p /logs/verifier /logs/agent /logs/artifacts /app /verifier /tests

# Generated from evals/benchmark-oracle.ps1. BenchFlow 0.6.5 copies only this
# Dockerfile into generated task contexts, so keep the payload self-contained.
ARG MYCELIUM_ORACLE_
ARG MYCELIUM_CAP_VERIFIER_
ARG MYCELIUM_LINEAGE_VERIFIER_
RUN mkdir -p /opt/mycelium-eval \
    && printf '%s' "$MYCELIUM_ORACLE_BASE64" | base64 -d > /opt/mycelium-eval/benchmark-oracle.ps1 \
    && printf '%s' "$MYCELIUM_CAP_VERIFIER_BASE64" | base64 -d > /opt/mycelium-eval/verify-cap.py \
    && printf '%s' "$MYCELIUM_LINEAGE_VERIFIER_BASE64" | base64 -d > /opt/mycelium-eval/mycelium_lineage.py \
    && chown root:root /opt/mycelium-eval/benchmark-oracle.ps1 /opt/mycelium-eval/verify-cap.py /opt/mycelium-eval/mycelium_lineage.py \
    && chmod 0444 /opt/mycelium-eval/benchmark-oracle.ps1 /opt/mycelium-eval/verify-cap.py /opt/mycelium-eval/mycelium_lineage.py

RUN chown evaluator:evaluator /app && chmod 0755 /app

USER evaluator:evaluator
WORKDIR /app
